# Copie para .env.local e substitua pelo endereço fornecido pelo Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Use um segredo longo e exclusivo para proteger o painel administrativo.
ADMIN_TOKEN=troque-por-um-segredo-longo

# Dados oficiais para gerar o PIX Copia e Cola da entrada. Não use valores fictícios em produção.
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=
